# Backend environment variables — copy to .env for local dev.
# On Vercel (backend project): add ALL of these in Project Settings → Environment Variables.

# Port for local `npm start` / `npm run dev` (Vercel ignores this)
PORT=5000
NODE_ENV=development

# MongoDB connection string (Atlas). REQUIRED — the app refuses to boot in
# production without it.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/illahroohcafe

# JWT signing secret — use a long random string (openssl rand -base64 48). REQUIRED.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Allowed frontend origin(s) for CORS, comma-separated if multiple (e.g. a
# domain and its preview domain). REQUIRED in production — cross-origin
# requests from other domains are blocked.
CLIENT_URL=https://your-frontend.vercel.app
FRONTEND_URL=https://your-frontend.vercel.app

# Razorpay credentials — required for online payments.
# Live keys: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
# Webhook secret used to verify Razorpay webhook signatures (set in Razorpay
# Dashboard → Settings → Webhooks → https://<backend>/api/payment/webhook)
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret

# Cloudinary — required for menu image uploads.
# https://console.cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# SMTP — required for the "Forgot password" email flow.
# Any provider (Gmail app password, Mailgun, Resend SMTP, Zoho...).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password
EMAIL_FROM="Ilarooh <no-reply@example.com>"