# Frontend environment variables (copy to .env.local and fill in)
# Base URL of the Express API — no trailing slash after /api
VITE_API_URL=

# Set to "false" once the Express backend is running to use real endpoints.
# Any other value (or unset) keeps the built-in mock data layer.
VITE_USE_MOCK_API=

# Razorpay PUBLISHABLE key id only. NEVER put RAZORPAY_KEY_SECRET here.
VITE_RAZORPAY_KEY_ID=
