# Frontend environment variables (Vercel: Project Settings → Environment Variables)

# Public base URL of the deployed backend API (no trailing slash on the domain).
# Example: https://illahrooh-backend.vercel.app/api
# Leave empty for local development in VS Code/Codespaces — the Vite /api proxy
# (vite.config.ts) forwards requests to the local backend automatically.
VITE_API_URL=

# Razorpay publishable (KEY_ID) — REQUIRED for online payments. Get it from
# https://dashboard.razorpay.com/app/keys. Leave empty to disable online checkout
# (orders then fall back to cash on delivery).
VITE_RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXX